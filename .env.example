# Copy this file to .env.local and put provider keys there.
# Never put keys in firmware, frontend JavaScript, or Git.
# Comma-separated OpenRouter keys; Buddy tries the next key on failed or empty replies.
# The free router has zero token pricing but is rate limited and can vary models.
OPENROUTER_API_KEYS=replace_with_first_key,replace_with_backup_key
OPENROUTER_MODEL=openrouter/free
# ElevenLabs TTS runs first. Add comma-separated backup keys with Text to Speech
# permission; quota/rate-limited keys move to the end of the list. Gemini is
# attempted only after all ElevenLabs keys fail. Keep real keys in .env.local.
ELEVENLABS_API_KEY=replace_with_your_elevenlabs_key
ELEVENLABS_API_KEYS=replace_with_backup_one,replace_with_backup_two
ELEVENLABS_MODEL=eleven_multilingual_v2
GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Optional separately deployed NVIDIA Speech NIM for speech fallback.
# NVIDIA_TTS_URL=http://your-speech-nim:9000
# NVIDIA_TTS_API_KEY=optional_separate_speech_key
PORT=4173
# Local development uses ignored JSON files by default. For the cloud backend,
# set BUDDY_STORAGE=supabase and provide both values privately on Render.
# Use a NEW sb_secret_ key, not the publishable key or database password.
# BUDDY_STORAGE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=replace_with_server_only_key
# Optional trusted-LAN gateway for an ESP32/phone. Keep localhost by default.
# Accounts and pairing are included; production hardening is still required.
# BUDDY_HOST=0.0.0.0
# On a non-Render HTTPS host, set its public origin so My Buddy shows the
# direct backend address for ESP32 setup (not the Vercel frontend address).
# BUDDY_PUBLIC_URL=https://your-buddy-backend.example.com
# Phone camera/mic require HTTPS. Use a trusted certificate or HTTPS proxy.
# BUDDY_TLS_CERT=/absolute/path/to/server-certificate.pem
# BUDDY_TLS_KEY=/absolute/path/to/server-private-key.pem
# Cross-network app calls generally need your own TURN service. Optional JSON:
# BUDDY_ICE_SERVERS=[{"urls":"turn:your-server:3478","username":"...","credential":"..."}]
# Isolated legacy regression tests only. Never enable with real care accounts.
# BUDDY_LEGACY_DEMO=1
